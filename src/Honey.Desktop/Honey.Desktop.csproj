<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Honey.Domain\Honey.Domain.csproj" />
    <ProjectReference Include="..\Honey.Simulation\Honey.Simulation.csproj" />
    <ProjectReference Include="..\Honey.Content.WhiteJadeSpider\Honey.Content.WhiteJadeSpider.csproj" />
    <ProjectReference Include="..\Honey.Persistence\Honey.Persistence.csproj" />
    <ProjectReference Include="..\Honey.Rendering\Honey.Rendering.csproj" />
    <ProjectReference Include="..\Honey.Integrations\Honey.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Honey.ico" />
    <EmbeddedResource Include="..\..\LICENSE"
                      LogicalName="Honey.LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md"
                      LogicalName="Honey.THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.en.md"
                      LogicalName="Honey.THIRD-PARTY-NOTICES.en.md" />
    <EmbeddedResource Include="..\..\LICENSES\**\*"
                      LogicalName="Honey.LICENSES.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Honey.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 为主宿主，清单需同时保留现代与兼容 DPI 声明；仅抑制 WinForms 的替代配置建议。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPublish)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 桌面分发优先控制下载体积；WPF 不做激进裁剪，使用单文件压缩取代 ReadyToRun。 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <AssemblyName>Honey</AssemblyName>
  </PropertyGroup>

</Project>
