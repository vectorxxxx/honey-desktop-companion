<Window x:Class="Honey.Desktop.Status.PetCodexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小玉 · 灵兽谱"
        Width="448"
        Height="684"
        MinWidth="410"
        MinHeight="580"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="#081112"
        Foreground="#E7FFF8"
        FontFamily="Microsoft YaHei UI"
        AutomationProperties.Name="小玉灵兽谱">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/JadeControlTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="CodexBackground" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F60A1415" Offset="0"/>
                <GradientStop Color="#F60E211F" Offset="0.55"/>
                <GradientStop Color="#F6081112" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeaderGlow" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#362B8275" Offset="0"/>
                <GradientStop Color="#081B3C38" Offset="0.65"/>
                <GradientStop Color="#00215D53" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="ChromeButton" TargetType="Button">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Background" Value="#102A2928"/>
                <Setter Property="BorderBrush" Value="#385E5954"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#B8D7D0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="19">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#245349"/>
                                    <Setter Property="Foreground" Value="#E8FFF9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NeedBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="7"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="Foreground" Value="#83E0CF"/>
                <Setter Property="Background" Value="#18312F"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid SnapsToDevicePixels="True">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4"/>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#669FEEE0"
                                                          BlurRadius="7"
                                                          ShadowDepth="0"
                                                          Opacity="0.55"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#B8102121"/>
                <Setter Property="BorderBrush" Value="#3656504D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#76B6AA"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#50736C"
            BorderThickness="1"
            CornerRadius="18"
            Background="{StaticResource CodexBackground}">
        <Grid ClipToBounds="True">
            <Ellipse Width="330"
                     Height="330"
                     Margin="-190,-205,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Fill="#102D9E8C"
                     IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="54"/>
                </Ellipse.Effect>
            </Ellipse>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="{StaticResource HeaderGlow}"
                      MouseLeftButtonDown="OnTitleMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            CornerRadius="22"
                            Background="#1C45403D"
                            BorderBrush="#4B91857C"
                            BorderThickness="1">
                        <Path Data="{StaticResource IconActivity}"
                              Width="21"
                              Height="21"
                              Stretch="Uniform"
                              Stroke="#A9F5E7"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="13,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="灵兽谱"
                                   FontFamily="Microsoft YaHei UI Semibold"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="WHITE JADE FAMILIAR · LIVE ARCHIVE"
                                   Margin="0,3,0,0"
                                   Foreground="#6F9B94"
                                   FontFamily="Cascadia Mono"
                                   FontSize="9"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="PinButton"
                                Style="{StaticResource ChromeButton}"
                                Click="OnPinClick"
                                ToolTip="切换窗口置顶"
                                AutomationProperties.Name="切换灵兽谱置顶">
                            <Path Data="{StaticResource IconPin}"
                                  Width="17"
                                  Height="17"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}"
                                Click="OnCloseClick"
                                ToolTip="关闭灵兽谱"
                                AutomationProperties.Name="关闭灵兽谱">
                            <Path Data="{StaticResource IconX}"
                                  Width="17"
                                  Height="17"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="18,16,18,20"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="76" Height="76" VerticalAlignment="Center">
                                    <Ellipse Fill="#183C3835"
                                             Stroke="#47776E"
                                             StrokeThickness="1"/>
                                    <Ellipse Width="58"
                                             Height="58"
                                             Stroke="#285A524D"
                                             StrokeDashArray="2,3"
                                             StrokeThickness="1"/>
                                    <Path Data="{StaticResource IconCompass}"
                                          Width="29"
                                          Height="29"
                                          Stretch="Uniform"
                                          Stroke="#8ED7CA"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="契约灵兽 · 白玉蜘蛛"/>
                                    <TextBlock x:Name="NameText"
                                               Margin="0,3,0,0"
                                               Text="小玉"
                                               FontSize="27"
                                               FontWeight="SemiBold"
                                               Foreground="#EDFFF9"/>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Border Padding="9,4"
                                                CornerRadius="10"
                                                Background="#1A514940">
                                            <TextBlock x:Name="MoodText"
                                                       Text="好奇"
                                                       Foreground="#A9F5E7"
                                                       FontSize="11"/>
                                        </Border>
                                        <Border Margin="7,0,0,0"
                                                Padding="9,4"
                                                CornerRadius="10"
                                                Background="#182A3B3A">
                                            <TextBlock x:Name="ModeText"
                                                       Text="常态 · 白玉"
                                                       Foreground="#B7D4CE"
                                                       FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="生命体征"/>
                                    <TextBlock HorizontalAlignment="Right"
                                               Foreground="#587D76"
                                               FontFamily="Cascadia Mono"
                                               FontSize="9"
                                               Text="NEEDS / 100"/>
                                </Grid>

                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="饥饿" Foreground="#AFC9C3" FontSize="12"/>
                                    <ProgressBar x:Name="HungerGauge" Grid.Column="1" Margin="4,0,10,0"
                                                 VerticalAlignment="Center" Style="{StaticResource NeedBar}"
                                                 Foreground="#E0B675"/>
                                    <TextBlock x:Name="HungerValue" Grid.Column="2" HorizontalAlignment="Right"
                                               Foreground="#E8D2A9" FontFamily="Cascadia Mono" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="精力" Foreground="#AFC9C3" FontSize="12"/>
                                    <ProgressBar x:Name="EnergyGauge" Grid.Column="1" Margin="4,0,10,0"
                                                 VerticalAlignment="Center" Style="{StaticResource NeedBar}"/>
                                    <TextBlock x:Name="EnergyValue" Grid.Column="2" HorizontalAlignment="Right"
                                               Foreground="#A9F5E7" FontFamily="Cascadia Mono" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="好奇" Foreground="#AFC9C3" FontSize="12"/>
                                    <ProgressBar x:Name="CuriosityGauge" Grid.Column="1" Margin="4,0,10,0"
                                                 VerticalAlignment="Center" Style="{StaticResource NeedBar}"
                                                 Foreground="#79C9ED"/>
                                    <TextBlock x:Name="CuriosityValue" Grid.Column="2" HorizontalAlignment="Right"
                                               Foreground="#A5DDF5" FontFamily="Cascadia Mono" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="亲密" Foreground="#AFC9C3" FontSize="12"/>
                                    <ProgressBar x:Name="AffectionGauge" Grid.Column="1" Margin="4,0,10,0"
                                                 VerticalAlignment="Center" Style="{StaticResource NeedBar}"
                                                 Foreground="#D996BB"/>
                                    <TextBlock x:Name="AffectionValue" Grid.Column="2" HorizontalAlignment="Right"
                                               Foreground="#F2B9DA" FontFamily="Cascadia Mono" FontSize="11"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="压力" Foreground="#AFC9C3" FontSize="12"/>
                                    <ProgressBar x:Name="StressGauge" Grid.Column="1" Margin="4,0,10,0"
                                                 VerticalAlignment="Center" Style="{StaticResource NeedBar}"
                                                 Foreground="#E77C6F"/>
                                    <TextBlock x:Name="StressValue" Grid.Column="2" HorizontalAlignment="Right"
                                               Foreground="#F1A69E" FontFamily="Cascadia Mono" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Eyebrow}" Text="当前行为"/>
                                        <TextBlock x:Name="BehaviorText"
                                                   Margin="0,5,0,0"
                                                   Text="观察"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Border x:Name="OriginBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Padding="10,6"
                                            CornerRadius="13"
                                            Background="#183F3A37"
                                            BorderBrush="#47776E"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="OriginIcon"
                                                  Data="{StaticResource IconCompass}"
                                                  Width="13"
                                                  Height="13"
                                                  Stretch="Uniform"
                                                  Stroke="#9FE9DB"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                            <TextBlock x:Name="OriginText"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="本地自主"
                                                       Foreground="#BCEFE5"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="阶段" Foreground="#668B84" FontSize="10"/>
                                        <TextBlock x:Name="PhaseText" Margin="0,3,0,0"
                                                   Text="追踪" Foreground="#D5E9E4" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="持续" Foreground="#668B84" FontSize="10"/>
                                        <TextBlock x:Name="DurationText" Margin="0,3,0,0"
                                                   Text="0秒" Foreground="#D5E9E4"
                                                   FontFamily="Cascadia Mono" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,11">
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="近期活动"/>
                                    <Path HorizontalAlignment="Right"
                                          Data="{StaticResource IconClock}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Stroke="#638D85"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Grid>
                                <ItemsControl x:Name="ActivityList"
                                              AutomationProperties.Name="最近六条灵兽活动">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="10,8"
                                                    Background="#101B302E"
                                                    CornerRadius="8"
                                                    BorderBrush="#233F3B"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="#AFC7C1"
                                                           FontFamily="Microsoft YaHei UI"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
