<Window x:Class="Honey.Desktop.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Honey 设置" Width="800" Height="760"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#0B1516" Foreground="#E7FFF8"
        AutomationProperties.Name="Honey 白玉蜘蛛设置">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Honey.Desktop;component/Assets/JadeControlTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#DFFFF7"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style x:Key="ActionButton"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#567C75" BorderThickness="1" CornerRadius="14" Background="#F20B1516">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#152827" MouseLeftButtonDown="OnTitleMouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSettings}" Stroke="#8ED7CA" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="24" Height="24" Stretch="Uniform"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="玉魄调息" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="白玉蜘蛛的行为、形态与系统习惯" Foreground="{DynamicResource JadeMutedTextBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#B7D4CE"
                        ToolTip="关闭设置" AutomationProperties.Name="关闭设置" Click="OnCancelClick">
                    <Path Data="{StaticResource IconX}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="20" Height="20" Stretch="Uniform"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <UniformGrid Columns="2">
                    <Border Margin="0,0,10,12" Padding="20" Background="#B3122424" CornerRadius="12" BorderBrush="#355A55" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="灵兽"/>
                            <TextBlock Text="体型" Foreground="{DynamicResource JadeMutedTextBrush}"/>
                            <Grid Margin="0,8,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <Slider x:Name="PetSizeSlider" Minimum="60" Maximum="240" TickFrequency="10"
                                        IsSnapToTickEnabled="True" ToolTip="调整白玉蜘蛛尺寸"
                                        AutomationProperties.Name="灵兽尺寸" ValueChanged="OnPetSizeChanged"/>
                                <TextBlock x:Name="PetSizeValue" Grid.Column="1" HorizontalAlignment="Right" FontSize="18" Foreground="{DynamicResource JadeAccentBrush}"/>
                            </Grid>
                            <TextBlock Text="形态偏好" Foreground="{DynamicResource JadeMutedTextBrush}"/>
                            <ComboBox x:Name="ModeCombo" Margin="0,8,0,0" AutomationProperties.Name="形态偏好">
                                <ComboBoxItem Tag="auto" Content="自动感应"/>
                                <ComboBoxItem Tag="normal" Content="常态 · 青白玉"/>
                                <ComboBoxItem Tag="berserk" Content="狂暴 · 猩红"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Margin="10,0,0,12" Padding="20" Background="#B3122424" CornerRadius="12" BorderBrush="#355A55" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="行为"/>
                            <TextBlock Text="自主活动频率" Foreground="{DynamicResource JadeMutedTextBrush}"/>
                            <ComboBox x:Name="ActivityCombo" Margin="0,8,0,14" AutomationProperties.Name="自主活动频率">
                                <ComboBoxItem Tag="quiet" Content="清静 · 偶尔活动"/>
                                <ComboBoxItem Tag="balanced" Content="均衡 · 自然节奏"/>
                                <ComboBoxItem Tag="active" Content="灵动 · 频繁探索"/>
                            </ComboBox>
                            <TextBlock Text="活动度会影响技能间隔；暂停后需求仍会低频变化。"
                                       Foreground="{DynamicResource JadeMutedTextBrush}" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,10,0" Padding="20" Background="#B3122424" CornerRadius="12" BorderBrush="#355A55" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="系统"/>
                            <CheckBox x:Name="AutoStartCheck" Content="随 Windows 启动并在后台待机"
                                      ToolTip="仅写入当前用户启动项" AutomationProperties.Name="开机自启动"/>
                            <CheckBox x:Name="FocusCheck" Content="全屏或锁屏时降低活动"
                                      ToolTip="渲染降至最多 30 帧，意图评估减半"
                                      AutomationProperties.Name="专注模式"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="10,0,0,0" Padding="20" Background="#B3122424" CornerRadius="12" BorderBrush="#355A55" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="智能与声音"/>
                            <CheckBox x:Name="AiCheck" Content="启用可配置 AI"
                                      AutomationProperties.Name="启用人工智能"/>
                            <TextBlock Text="服务地址" Foreground="{DynamicResource JadeMutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBox x:Name="AiEndpointText" Margin="0,5,0,0"
                                     ToolTip="OpenAI 兼容服务的 /v1 地址或完整 chat/completions 地址"
                                     AutomationProperties.Name="AI 服务地址"/>
                            <TextBlock Text="模型" Foreground="{DynamicResource JadeMutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBox x:Name="AiModelText" Margin="0,5,0,0"
                                     ToolTip="服务支持的模型名称"
                                     AutomationProperties.Name="AI 模型"/>
                            <TextBlock Text="API 密钥" Foreground="{DynamicResource JadeMutedTextBrush}" Margin="0,8,0,0"/>
                            <PasswordBox x:Name="AiKeyPassword" Margin="0,5,0,0"
                                         ToolTip="留空即保持已保存密钥，不会回显"
                                         AutomationProperties.Name="AI API 密钥"/>
                            <TextBlock x:Name="AiKeyStatus" Foreground="{DynamicResource JadeMutedTextBrush}"
                                       FontSize="11" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <Button x:Name="TestAiButton"
                                        Style="{StaticResource ActionButton}" Margin="0"
                                        Click="OnTestAiClick" ToolTip="仅此次主动点击会联网"
                                        AutomationProperties.Name="测试 AI 连接" Content="测试连接"/>
                                <Button Style="{StaticResource ActionButton}"
                                        Click="OnClearAiKeyClick" ToolTip="保存设置时清除安全密钥"
                                        AutomationProperties.Name="清除 AI 密钥" Content="清除密钥"/>
                            </StackPanel>
                            <CheckBox x:Name="SoundCheck" Content="启用声音"
                                      AutomationProperties.Name="启用声音"/>
                            <TextBlock Text="音量" Foreground="{DynamicResource JadeMutedTextBrush}" Margin="0,8,0,0"/>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                                    AutomationProperties.Name="声音音量" ToolTip="首版保存配置，不会虚假播放音频"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="24,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Foreground="{DynamicResource JadeErrorBrush}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Click="OnRestoreDefaultsClick"
                            ToolTip="恢复所有默认设置" AutomationProperties.Name="恢复默认设置">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRotate}" Stroke="#E7FFF8" StrokeThickness="2"
                                  Width="17" Height="17" Stretch="Uniform"/>
                            <TextBlock Text="恢复默认" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Click="OnCancelClick"
                            AutomationProperties.Name="取消设置" Content="取消"/>
                    <Button Style="{StaticResource ActionButton}"
                            Background="{StaticResource JadePrimaryActionBrush}" Click="OnSaveClick"
                            IsDefault="True" AutomationProperties.Name="保存设置">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSave}" Stroke="#E7FFF8" StrokeThickness="2"
                                  Width="17" Height="17" Stretch="Uniform"/>
                            <TextBlock Text="保存" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
